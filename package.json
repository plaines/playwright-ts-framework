{
  "name": "playwright-ts-framework",
  "version": "1.0.0",
  "description": "Basic automation framework with Playwright + TypeScript (OrangeHRM UI + FakeStore API + BDD)",
  "type": "commonjs",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "test:local": "cross-env TEST_ENV=local npm test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
